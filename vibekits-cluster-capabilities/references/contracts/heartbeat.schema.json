{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "heartbeat device-capability/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "device-capability/1"
    },
    "serverId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[0-9]{6,16}$"
    },
    "sessionEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "heartbeatId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "healthSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "profileRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "health": {
      "$ref": "#/$defs/health"
    }
  },
  "required": [
    "schemaVersion",
    "serverId",
    "deviceId",
    "sessionEpoch",
    "heartbeatId",
    "healthSeq",
    "profileRevision",
    "health"
  ],
  "$defs": {
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "userStatement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "maxItems": 20
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "maxItems": 20
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "maxItems": 20
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "maxItems": 30
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "maxItems": 30
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "skillRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "executionMode": {
          "enum": [
            "unknown",
            "agent_assisted",
            "deterministic",
            "both"
          ]
        }
      },
      "required": [
        "title",
        "userStatement",
        "summary",
        "inputs",
        "outputs",
        "methods",
        "conditions",
        "limitations",
        "tags",
        "skillRefs",
        "executionMode"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "claimRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabled": {
          "type": "boolean"
        },
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "origin": {
          "enum": [
            "user_ui",
            "user_dialogue",
            "installed_skill"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "claimId",
        "claimRevision",
        "enabled",
        "declaration",
        "origin",
        "updatedAt"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "enum": [
            "bundled",
            "approved_global",
            "workspace"
          ]
        },
        "status": {
          "enum": [
            "discovered",
            "adapted",
            "disabled"
          ]
        }
      },
      "required": [
        "skillId",
        "version",
        "contentSha256",
        "source",
        "status"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "device",
                "model",
                "claim",
                "resource"
              ]
            },
            "refId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "required": [
            "kind",
            "refId"
          ]
        },
        "probeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "state": {
          "enum": [
            "unknown",
            "checking",
            "ready",
            "needs_configuration",
            "needs_approval",
            "busy",
            "unavailable",
            "stale"
          ]
        },
        "reasonCode": {
          "type": "string",
          "maxLength": 128
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "maxItems": 30
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "observationId",
        "subject",
        "probeId",
        "state",
        "reasonCode",
        "evidenceRefs",
        "observedAt",
        "expiresAt"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "credentialRequired": {
          "type": "boolean"
        },
        "credentialPresent": {
          "type": "boolean"
        },
        "credentialStatus": {
          "enum": [
            "not_required",
            "missing",
            "checking",
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "modelStatus": {
          "enum": [
            "not_configured",
            "checking",
            "ready",
            "auth_failed",
            "quota_exhausted",
            "rate_limited",
            "network_error",
            "unknown"
          ]
        },
        "modelReady": {
          "type": "boolean"
        },
        "keyReady": {
          "type": "boolean"
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "providerRef",
        "credentialRequired",
        "credentialPresent",
        "credentialStatus",
        "modelStatus",
        "modelReady",
        "keyReady",
        "checkedAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "credentialRequired": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "credentialStatus": {
                "const": "not_required"
              },
              "keyReady": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "modelReady": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "modelStatus": {
                "const": "ready"
              },
              "checkedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "keyReady": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "credentialRequired": {
                "const": true
              },
              "credentialPresent": {
                "const": true
              },
              "credentialStatus": {
                "const": "valid"
              },
              "checkedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusterEnabled": {
              "const": true
            },
            "simulationEnabled": {
              "type": "boolean"
            },
            "simulationReady": {
              "type": "boolean"
            },
            "simulationSupported": {
              "type": "boolean"
            }
          },
          "required": [
            "clusterEnabled",
            "simulationEnabled",
            "simulationReady",
            "simulationSupported"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "simulationReady": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "simulationEnabled": {
                    "const": true
                  },
                  "simulationSupported": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
        "agentState": {
          "enum": [
            "not_configured",
            "starting",
            "healthy",
            "busy",
            "waiting_approval",
            "degraded",
            "crashed",
            "unresponsive",
            "disabled",
            "unknown"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          },
          "maxItems": 100
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "totalSlots": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "running": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "queued": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "totalSlots",
            "running",
            "queued"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "channels",
        "agentState",
        "models",
        "capacity",
        "observedAt"
      ]
    }
  }
}
